<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Launch theme. Light-only product. The window background doubles as the
      pre-Android-12 splash (brand mark on the canvas colour); Android 12+
      uses the SplashScreen attributes in values-v31. The full Material 3
      theme lives in Compose (core/designsystem/Theme.kt).
    -->
    <style name="Theme.HisabGhor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
